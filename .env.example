# Local development defaults. Node does not load this file automatically;
# export variables in your shell or run compiled entrypoints with --env-file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
WORKFLOW_TIMEOUT_SECONDS=30

# Local supplier endpoints. Docker Compose supplies container-network URLs.
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels
SUPPLIER_TIMEOUT_MS=3000

CACHE_TTL_SECONDS=60
DEGRADED_CACHE_TTL_SECONDS=10

# Enables POST /supplierA/_chaos and /supplierB/_chaos for local failure tests.
MOCK_CHAOS_ENABLED=true
