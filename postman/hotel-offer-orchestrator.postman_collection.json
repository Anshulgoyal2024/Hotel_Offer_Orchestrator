    {
      "name": "03 - Supplier failure (run in order)",
      "item": [
        {
          "name": "1. Take Supplier A down",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/supplierA/_chaos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierA",
                "_chaos"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\"down\": true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Chaos state updated\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Delhi with Supplier A down -> degraded result from B only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&refresh=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "refresh",
                  "value": "true"
                }
              ]
            },
            "description": "Activity retries (3 attempts, exponential backoff) then the workflow continues with Supplier B. Takes ~2s."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 (graceful degradation)\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Flagged as degraded via headers\", () => {",
                  "  pm.expect(pm.response.headers.get(\"X-Data-Degraded\")).to.eql(\"true\");",
                  "  pm.expect(pm.response.headers.get(\"X-Failed-Suppliers\")).to.eql(\"Supplier A\");",
                  "});",
                  "pm.test(\"Only Supplier B offers are returned\", () => {",
                  "  pm.expect(body.length).to.be.greaterThan(0);",
                  "  body.forEach(h => pm.expect(h.supplier).to.eql(\"Supplier B\"));",
                  "});",
                  "pm.test(\"Holtin still resolves to B's 5340\", () => pm.expect(body.find(h => h.name === \"Holtin\").price).to.eql(5340));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Health reports degraded (Supplier A down)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
