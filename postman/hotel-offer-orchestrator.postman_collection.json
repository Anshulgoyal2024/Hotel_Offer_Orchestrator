{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Postman collection for the Hotel Offer Orchestrator.\n\nRun the whole collection top-to-bottom with the Collection Runner (order matters: the 'Supplier failure' folder switches the mock suppliers off and the last request switches them back on).\n\nPrerequisite: `docker compose up --build` (API on http://localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health (API, Redis, Temporal, Supplier A, Supplier B)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test(\"Overall status is ok\", () => pm.expect(h.status).to.eql(\"ok\"));",
                  "pm.test(\"Both suppliers, Redis and Temporal are reported\", () => {",
                  "  [\"supplierA\", \"supplierB\", \"redis\", \"temporal\"].forEach(k => pm.expect(h.dependencies[k].status, k).to.eql(\"up\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Liveness (process only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ],
              "query": []
            },
            "description": "Checks that the API process responds without probing Redis, Temporal, or suppliers."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Liveness is ok\", () => pm.expect(pm.response.json()).to.eql({ status: \"ok\" }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Hotels",
      "item": [
        {
          "name": "Delhi - de-duplicated best offers (forced fresh run)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&refresh=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "refresh",
                  "value": "true"
                }
              ]
            },
            "description": "Runs the Temporal workflow (refresh=true bypasses the Redis cache) and returns the cheapest offer per hotel."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const byName = Object.fromEntries(body.map(h => [h.name.toLowerCase(), h]));",
                  "",
                  "pm.test(\"Status is 200 and body is a bare array\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Each item has exactly name, price, supplier, commissionPct\", () => {",
                  "  body.forEach(h => pm.expect(Object.keys(h).sort()).to.eql([\"commissionPct\", \"name\", \"price\", \"supplier\"]));",
                  "});",
                  "pm.test(\"Hotel names are de-duplicated (case/space-insensitive)\", () => {",
                  "  const keys = body.map(h => h.name.toLowerCase().replace(/\\s+/g, \" \").trim());",
                  "  pm.expect(new Set(keys).size).to.eql(keys.length);",
                  "  pm.expect(body.length).to.eql(8);",
                  "});",
                  "pm.test(\"Holtin -> Supplier B at 5340 (cheaper than A's 6000)\", () => {",
                  "  pm.expect(byName[\"holtin\"]).to.include({ price: 5340, supplier: \"Supplier B\", commissionPct: 20 });",
                  "});",
                  "pm.test(\"Radison -> Supplier A at 5900 (cheaper than B's 6200)\", () => {",
                  "  pm.expect(byName[\"radison\"]).to.include({ price: 5900, supplier: \"Supplier A\", commissionPct: 13 });",
                  "});",
                  "pm.test(\"Lemon Tree is matched across spelling differences\", () => {",
                  "  pm.expect(byName[\"lemon tree\"]).to.include({ price: 4200, supplier: \"Supplier A\" });",
                  "});",
                  "pm.test(\"Price tie (Ibis 3800) is won by the higher commission -> Supplier B\", () => {",
                  "  pm.expect(byName[\"ibis\"]).to.include({ price: 3800, supplier: \"Supplier B\", commissionPct: 12 });",
                  "});",
                  "pm.test(\"Single-supplier hotels are kept\", () => {",
                  "  pm.expect(byName[\"hotel aravali\"].supplier).to.eql(\"Supplier A\");",
                  "  pm.expect(byName[\"leela ambience\"].supplier).to.eql(\"Supplier B\");",
                  "});",
                  "pm.test(\"Sorted by price ascending\", () => {",
                  "  const prices = body.map(h => h.price);",
                  "  pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
                  "});",
                  "pm.test(\"Not degraded\", () => pm.expect(pm.response.headers.has(\"X-Data-Degraded\")).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delhi - second call is a Redis cache hit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
