                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only hotels priced 5000-10000 are returned\", () => pm.expect(body.map(h => h.name)).to.eql([\"Holtin\", \"Radison\", \"Leela Ambience\"]));",
                  "pm.test(\"Served via Redis (cache hit) or freshly aggregated\", () => pm.expect([\"HIT\", \"MISS\", \"REFRESH\"]).to.include(pm.response.headers.get(\"X-Cache\")));",
                  "",
                  "pm.test(\"Every price is within [5000, 10000]\", () => body.forEach(h => pm.expect(h.price).to.be.within(5000, 10000)));"
                ]
